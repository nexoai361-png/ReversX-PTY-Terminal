<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        id="cordova-plugin-native-keyboard-fix"
        version="1.0.0">
    <name>NativeKeyboardFix</name>
    <description>Native fix for terminal keyboard handling on Android</description>
    <license>Apache 2.0</license>
    <keywords>cordova,android,keyboard,terminal</keywords>

    <js-module src="www/NativeKeyboardFix.js" name="NativeKeyboardFix">
        <clobbers target="NativeKeyboardFix" />
    </js-module>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="NativeKeyboardFix">
                <param name="android-package" value="com.custom.keyboardfix.NativeKeyboardFix" />
            </feature>
        </config-file>

        <source-file src="src/android/NativeKeyboardFix.java" target-dir="src/com/custom/keyboardfix" />
    </platform>
</plugin>
